# agent-runtime: Node sidecar hosting pi AgentSessions.
FROM docker.m.daocloud.io/library/node:24-bookworm-slim
RUN unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY no_proxy NO_PROXY && apt-get update && apt-get install -y --no-install-recommends bash git ripgrep \
    python3 python3-pip python3-venv \
    libpango-1.0-0 libpangocairo-1.0-0 libgdk-pixbuf-2.0-0 libcairo2 \
    fonts-noto-cjk fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*
# Built-in expert rendering stacks:
#   ppt-master → WeasyPrint HTML→PDF + python-pptx
#   excel-master → openpyxl + pandas (Excel read/write/formulas/charts)
RUN unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY no_proxy NO_PROXY && pip3 install --no-cache-dir --break-system-packages -i https://pypi.tuna.tsinghua.edu.cn/simple weasyprint python-pptx openpyxl pandas
WORKDIR /app
COPY services/agent-runtime/package.json services/agent-runtime/package-lock.json* ./
RUN unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY no_proxy NO_PROXY && npm install --registry=https://registry.npmmirror.com
COPY services/agent-runtime/ ./
RUN unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY no_proxy NO_PROXY && npm run build
# protos are loaded at runtime from PROTO_DIR
COPY proto/ /app/proto/
ENV PROTO_DIR=/app/proto
EXPOSE 9100
CMD ["node", "dist/index.js"]
