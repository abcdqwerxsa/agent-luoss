# MinerU CPU parse service (2.x line: synchronous /file_parse endpoint).
# Self-built because official images are GPU/vllm-based; pipeline backend
# needs no CUDA. Weights download on first run (modelscope for CN networks).
FROM docker.m.daocloud.io/library/python:3.12-slim

ENV PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
    MINERU_MODEL_SOURCE=modelscope

RUN unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY no_proxy NO_PROXY && \
    pip3 install --no-cache-dir 'mineru[core]>=2,<4'

# parse outputs are throwaway (we read md from the JSON response)
VOLUME ["/tmp"]

EXPOSE 8000
CMD ["mineru-api", "--host", "0.0.0.0", "--port", "8000"]
