# Copy to .env and adjust. Used by docker compose and Go services.
POSTGRES_PASSWORD=agentdev
# 32+ byte random strings; generate with: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret
KEY_MASTER=change-me-aes-master-key
# Default monthly quota (USD) when no per-user quota is set
DEFAULT_MONTHLY_LIMIT_USD=100
